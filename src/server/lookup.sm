static int lookup_get_dirent_comp_fn(
    void *v_p, struct PVFS_server_resp *resp_p, int i);

static int read_remote_metadata_comp_fn(
    void *v_p, struct PVFS_server_resp *resp_p, int i);

enum 
{
    LOOKUP_LOCAL_METAFILE_KEYVALS = 21,
    STATE_ENOTDIR                 = 22,  /* used in init, not used in verify_obj_meta */
    STATE_NOMORESEGS              = 23,  /* not used */
    LOOKUP_CHECK_DIR_ACLS         = 24,
    LOOKUP_CHECK_PERMS            = 25,
    LOCAL_DIRENT                  = 26,
    REMOTE_DIRENT                 = 27,
    LOCAL_SEGMENT                 = 28,
    REMOTE_SEGMENT                = 29
};

%%

machine pvfs2_lookup_sm
{
    state debug
    {
        run lookup_debug;
        default => prelude;
    }

    state prelude
    {
        jump pvfs2_prelude_sm;
        success => init;
        default => final_response;
    }

    state init
    {
        run lookup_init;
        STATE_ENOTDIR => setup_resp;
        default => get_dirdata_from_keyval;
    }

    state get_dirdata_from_keyval
    {
        run lookup_get_dirdata_from_keyval;
        success => compute_directory_entry_location;
        default => setup_resp;
    }

    state compute_directory_entry_location
    {
        run lookup_compute_directory_entry_location;
        LOCAL_DIRENT => read_directory_entry_local;
        REMOTE_DIRENT => read_directory_entry_remote;
        default => setup_resp;
    }

    state read_directory_entry_local
    {
        run lookup_read_directory_entry_local;
        success => read_object_metadata; 
        default => setup_resp;
    }

    state read_directory_entry_remote
    {
        run lookup_read_directory_entry_remote;
        success => read_directory_entry_xfer_msgpair;
        default => setup_resp;
    }

    state read_directory_entry_xfer_msgpair
    {
        jump pvfs2_msgpairarray_sm;
        success => read_object_metadata;
        default => setup_resp;
    }

    /* read an object attr for the current segment */

    state read_object_metadata
    {
        run lookup_read_object_metadata;
        LOCAL_SEGMENT => initiate_read_object_metadata;
        REMOTE_SEGMENT => setup_remote_metadata_request;
        /* success => initiate_read_object_metadata; */
        default => setup_resp;
    }

    state initiate_read_object_metadata
    {
        /* jump pvfs2_get_attr_work_sm; */
        jump pvfs2_get_attr_with_prelude_sm;
        default => verify_object_metadata;
    }

    state setup_remote_metadata_request
    {
        run remote_metadata_request;
        default => initiate_remote_request;
    }

    state initiate_remote_request
    {
        jump pvfs2_msgpairarray_sm;
        default => cleanup_remote_request;
    }

    state cleanup_remote_request
    {
        run cleanup_remote_request;
        default => verify_object_metadata;
    }

    state verify_object_metadata
    {
        run lookup_verify_object_metadata;
        LOOKUP_CHECK_PERMS => check_perms;
        LOOKUP_LOCAL_METAFILE_KEYVALS => setup_getattr_request;
        success => get_dirdata_from_keyval; /* Looping back from here */
        default => setup_resp;
    }

    /* processing file (metafile object) at the end of the path */

    state setup_getattr_request
    {
        run lookup_setup_getattr_request;
        success => initiate_getattr_request;
        default => setup_resp;
    }

    state initiate_getattr_request
    {
        jump pvfs2_get_attr_work_sm;
        default => verify_getattr_results;
    }

    state verify_getattr_results
    {
        run lookup_verify_getattr_results;
        default => setup_resp;
    }

    /* processing dir (directory object) permissions */

    state check_perms
    {
        run lookup_check_perms;
        LOOKUP_CHECK_DIR_ACLS => read_directory_acls;
        success => get_dirdata_from_keyval; /* Looping back from here */
        default => setup_resp;
    }

    state read_directory_acls
    {
        run lookup_read_directory_acls;
        default => check_acls;
    }

    state check_acls
    {
        run lookup_check_acls;
        success => get_dirdata_from_keyval; /* Looping back from here */
        default => setup_resp;
    }

    /* request finished set up and send response */

    state setup_resp
    {
        run lookup_setup_resp;
        default => final_response;
    }

    state final_response
    {
        jump pvfs2_final_response_sm;
        default => cleanup;
    }

    state cleanup
    {
        run lookup_cleanup;
        default => terminate;
    }
}

%%

static PINT_sm_action lookup_debug(struct PINT_smcb *smcb, job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    PVFS_debug_servreq_lookup_path(GOSSIP_LOOKUP_DEBUG, s_op->req);
    return SM_ACTION_COMPLETE;
}

/*
 * Function: lookup_init
 *
 * Synopsis: initializes internal structures and posts job to request
 * scheduler.
 *
 * Assumes req structure holds a valid path.
 *
 * Initializes segp, seg_ct, seg_nr fields in s_op->u.lookup.
 *
 * Allocates memory for handle and attribute arrays that will be
 * returned in the response.
 *
 * Note: memory is allocated as one big chunk, pointed to by
 * s_op->resp.u.lookup_path.handle_array.
 *
 */
static PINT_sm_action lookup_init(struct PINT_smcb *smcb, job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    char *ptr = NULL;
    int ret;

    /* Assuming that the s_op->attr and s_op->ds_attr
     * are always a directory object,
     * defined by the handle in the lookup_path request.
     * Prelude uses that handle
     * to access the dspace attributes, storing them in
     * s_op->ds_attr and s_op->attr.
     */
    if ( s_op->ds_attr.type != PVFS_TYPE_DIRECTORY )
    {
       gossip_lerr("Parent object is NOT a directory(%s)\n"
                 ,s_op->req->u.lookup_path.path);
       js_p->error_code = STATE_ENOTDIR;
       return SM_ACTION_COMPLETE;
    }

    /* set metasidcnt (# of sids per object) to the
     * sid_count found in the dspace entry
     * for this directory.  If the value is zero,
     * then use the filesystem sid_count defined
     * by the config file.
     * NOTE:  sid_count should ALWAYS be 1 or more.
     * 1 indicates no replication.
     * More than one indicates (sid_count - 1) number of replicas.
     * NOTE:  it is possible that the root has X # of replicas while
     * the system default has Y # of replicas.
     * So, if the s_op->target_handle is root, use the
     * system default metasidcount and NOT the root's sid count.  
     */

    gossip_lsdebug(GOSSIP_SERVER_DEBUG,
                   "%s:s_op->target_handle=(%s)\n", __func__,
                   PVFS_OID_str(&s_op->target_handle));

    PVFS_object_ref fs_root;
    memset(&fs_root, 0, sizeof(fs_root));
    ret = PINT_cached_config_get_root_ref(s_op->target_fs_id, &fs_root);
    if (ret)
    {
       gossip_lerr("Root handle for filesystem(%d) not found\n",
                   s_op->target_fs_id);
    }
    else
    {
       gossip_lsdebug(GOSSIP_SERVER_DEBUG,
                      "Root handle(%s)\n", 
                      PVFS_OID_str(&fs_root.handle));

       if (!PVFS_OID_cmp(&s_op->target_handle, &fs_root.handle))
       {
          gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                         "Target handle(%s) is root handle\n", 
                         PVFS_OID_str(&s_op->target_handle));
       }
       else
       {
          gossip_debug(GOSSIP_LOOKUP_DEBUG,
                       "Target handle(%s) is NOT a root handle\n", 
                       PVFS_OID_str(&s_op->target_handle));
       }
    }

    /* s_op->metasidcnt = s_op->attr.u.dir.dist_dir_attr.sid_count; */
    s_op->metasidcnt = s_op->attr.meta_sid_count;

    /* is this relevant any more?  Do we put proper MSC in root attr? */
    if ( !(PVFS_OID_cmp(&s_op->target_handle,&fs_root.handle)) )
    {
       /* get the filesystem value representing the
        * number of sids per metadata object,
        * resetting s_op->metasidcnt 
        */
       ret = PINT_cached_config_get_metadata_sid_count(s_op->req->u.lookup_path.fs_id,
                                                       &(s_op->metasidcnt));
       if (ret)
       {
          gossip_lerr("Error retrieving metadata sid count from config file.\n");
          js_p->error_code = ret;
          return SM_ACTION_COMPLETE;
       }
    }

    /* fill in the lookup portion of the PINT_server_op */
    s_op->u.lookup.segp = NULL;
    s_op->u.lookup.seg_nr = 0;
    s_op->u.lookup.array_index = 0;
    s_op->u.lookup.seg_ct = PINT_string_count_segments(s_op->req->u.lookup_path.path);
    s_op->u.lookup.handle_ct = 0;
    s_op->u.lookup.attr_ct = 0;
    gossip_debug(GOSSIP_LOOKUP_DEBUG,
                 "s_op lookup.handle_ct = %u\n", s_op->u.lookup.handle_ct);

    /* temp memory block for moving around dirents */
    s_op->u.lookup.temp_dirent_store = (PVFS_ID *)malloc(OSASZ(1, s_op->metasidcnt));
    
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "STARTING LOOKUP REQUEST "
                   "(path:%s)(fs_id:%d)(handle:%s)(attrmask:0x%0lx)"
                   "(# of segments:%u)\n",
                   s_op->req->u.lookup_path.path,
                   s_op->req->u.lookup_path.fs_id,
                   PVFS_OID_str(&s_op->req->u.lookup_path.handle),
                   s_op->req->u.lookup_path.attrmask,
                   s_op->u.lookup.seg_ct);

    if ((s_op->u.lookup.seg_ct < 0) ||
        (s_op->u.lookup.seg_ct > PVFS_REQ_LIMIT_PATH_SEGMENT_COUNT))
    {
        gossip_lerr("invalid path %s (bad segment count); "
                   "sending error response\n",
                   s_op->req->u.lookup_path.path);
        js_p->error_code = -PVFS_ENOTDIR;
        return SM_ACTION_DEFERRED;
    }

    /* allocate the internal ds_attr_array */
    s_op->u.lookup.ds_attr_array = (PVFS_ds_attributes *)
                   malloc(s_op->u.lookup.seg_ct * sizeof(PVFS_ds_attributes));
    if (!s_op->u.lookup.ds_attr_array)
    {
        js_p->error_code = -PVFS_ENOMEM;
        return SM_ACTION_COMPLETE;
    }

    /* allocate memory
     *
     * Note: all memory is allocated in a single block,
     * pointed to by s_op->resp.u.lookup_path.handle_array
     */
    /* for every handle, there will be a set of attributes and a list of
     * sids where those attributes are stored/replicated.
     */  
    ptr = malloc(s_op->u.lookup.seg_ct * (OSASZ(1, s_op->metasidcnt) +
                                          sizeof(PVFS_object_attr)));
    if (!ptr)
    {
        js_p->error_code = -PVFS_ENOMEM;
        return SM_ACTION_COMPLETE;
    }

    /* assign response buffers out of this block */
    s_op->resp.u.lookup_path.handle_array = (PVFS_handle *)ptr;
    ptr += (s_op->u.lookup.seg_ct * sizeof(PVFS_handle));

    s_op->resp.u.lookup_path.attr_array = (PVFS_object_attr *)ptr;
    ptr += (s_op->u.lookup.seg_ct * sizeof(PVFS_object_attr));

    s_op->resp.u.lookup_path.sid_array = (PVFS_SID *)ptr;

    //s_op->resp.u.lookup_path.handle_count = s_op->resp.u.lookup_path.attr_count 
    //                                      = s_op->resp.u.lookup_path.sid_count
    //                                      = s_op->u.lookup.seg_ct;

    js_p->error_code = 0;
    return SM_ACTION_COMPLETE;
}

/*
 * Function: lookup_get_dirdata_from_keyval
 *
 * Synopsis: Given a directory handle, read the dirdata handles and bitmap
 * from the keyval database.
 *
 * store directory entries for this directory.
 *
 * The handle to use for the * read is either:
 * - the starting handle from the req (if we haven't looked up a
 *   segment yet), or
 * - the previous segment's handle (from response handle array).
 *
 * Arranges the handle and attrs for the dir according to where it
 * originated: prelude, for initial dir or on a previous cycle.
 *
 * NOTE: Segments of the path loop back here
 *
 */
static PINT_sm_action lookup_get_dirdata_from_keyval(struct PINT_smcb *smcb,
                                                     job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    int ret = -PVFS_EINVAL;
    PVFS_handle handle = PVFS_HANDLE_NULL;
    job_id_t j_id;
    PVFS_object_attr *attr;
    int keyval_count;

    /* Use the base handle if we haven't looked up a segment yet. In this
     * case, attributes are already provided by the prelude
     * and are stored in s_op->attr.  Otherwise in the attr_array
     */

    if (s_op->u.lookup.seg_nr == 0)
    {
        /* Attributes were just read by prelude */
        s_op->u.lookup.attr = s_op->attr;
    }
    else
    {
        /* We have looped for another segment
         * Attributes of the new segment are in s_op->resp attr_array
         */
        /* WTF??? They are already in resp - then why copy to the frame?
         * at this point getting rid of the frame copy is too much work,
         * but we need to make sure the copy already in resp is not used.
         */
    /* THis is some confusng shit.  here we set a pointer in the s_op u.lookup.attr
     * to another pointer in the s_op being resp.u.lookup_path.attr_array[...] which
     * creates an interesting aliasing situation.  We also set the local ptr attr to
     * point to this for convenience, but it goes away and the end of the function.
     * In the next function, after reading from the db there is data copied between
     * these addresses, in such a way it is very difficult to understand.
     */
     /* PLUS we never copy attrs this way, we have a specific copy routine !!!
     */

        ret = PINT_copy_object_attr(&s_op->u.lookup.attr,
                     &s_op->resp.u.lookup_path.attr_array[s_op->u.lookup.array_index]);

        /*s_op->u.lookup.attr =
             s_op->resp.u.lookup_path.attr_array[s_op->u.lookup.array_index];*/
    }
    attr = &s_op->u.lookup.attr;

    assert(attr->u.dir.dist_dir_attr.dirdata_count > 0 &&
           attr->u.dir.dist_dir_attr.bitmap_size > 0);

    /* use the base handle if we haven't looked up a segment yet */
    if (s_op->u.lookup.seg_nr == 0)
    {
        /* initial dir */
        handle = s_op->req->u.lookup_path.handle;
    }
    else
    {
        /* We have looped for another segment */
        handle =
             s_op->resp.u.lookup_path.handle_array[s_op->u.lookup.array_index ];
    }

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "lookup: get dist-dir-attr for dir meta handle %s "
                   "with tree_height=%d, dirdata_min=%d, dirdata_max=%d, "
                   "dirdata_count=%d, sid_count=%d, bitmap_size=%d, "
                   "split_size=%d, server_no=%d and branch_level=%d\n",
                   PVFS_OID_str(&handle),
                   attr->u.dir.dist_dir_attr.tree_height,
                   attr->u.dir.dist_dir_attr.dirdata_min,
                   attr->u.dir.dist_dir_attr.dirdata_max,
                   attr->u.dir.dist_dir_attr.dirdata_count,
                   attr->u.dir.dist_dir_attr.sid_count,
                   attr->u.dir.dist_dir_attr.bitmap_size,
                   attr->u.dir.dist_dir_attr.split_size,
                   attr->u.dir.dist_dir_attr.server_no,
                   attr->u.dir.dist_dir_attr.branch_level);

    /* I don't think any of this is needed - except maybe on the first handle
     * The code below calls getattr to get the attributes, and it gets the
     * kval attribute automatically (or it should).  I can leave this and see
     * if it causes an error, but it is inefficient at best.
     */
    /* allocate space for bitmap and dirdata handles */
    attr->u.dir.dist_dir_bitmap =
            malloc(attr->u.dir.dist_dir_attr.bitmap_size *
                    sizeof(PVFS_dist_dir_bitmap_basetype));

    attr->u.dir.dirdata_handles =
                malloc(OSASZ(attr->u.dir.dist_dir_attr.dirdata_count,
                             attr->u.dir.dist_dir_attr.sid_count));

    if(!attr->u.dir.dist_dir_bitmap ||
            !attr->u.dir.dirdata_handles)
    {
        free(attr->u.dir.dist_dir_bitmap);
        free(attr->u.dir.dirdata_handles);
        js_p->error_code = -PVFS_ENOMEM;
        goto error_out;
    }

    /* Beginning of sids is immediately following the dirdata handles */
    attr->u.dir.dirdata_sids = 
                 (PVFS_SID *)&attr->u.dir.dirdata_handles[
                                    attr->u.dir.dist_dir_attr.dirdata_count];

    /* total 2 keyvals, DIST_DIRDATA_BITMAP, DIST_DIRDATA_HANDLES */
    keyval_count = 2;

    s_op->key_a = malloc(sizeof(PVFS_ds_keyval) * keyval_count);
    if(!s_op->key_a)
    {
        free(attr->u.dir.dist_dir_bitmap);
        free(attr->u.dir.dirdata_handles);
        js_p->error_code = -PVFS_ENOMEM;
        goto error_out;
    }

    s_op->val_a = malloc(sizeof(PVFS_ds_keyval) * keyval_count);
    if(!s_op->val_a)
    {
        js_p->error_code = -PVFS_ENOMEM;
        goto error_out;
    }
    memset(s_op->val_a, 0, sizeof(PVFS_ds_keyval) * keyval_count);

    s_op->key_a[0].buffer = Trove_Common_Keys[DIST_DIRDATA_BITMAP_KEY].key;
    s_op->key_a[0].buffer_sz = Trove_Common_Keys[DIST_DIRDATA_BITMAP_KEY].size;

    s_op->val_a[0].buffer_sz = attr->u.dir.dist_dir_attr.bitmap_size *
                               sizeof(PVFS_dist_dir_bitmap_basetype);
    s_op->val_a[0].buffer = attr->u.dir.dist_dir_bitmap;

    s_op->key_a[1].buffer = Trove_Common_Keys[DIST_DIRDATA_HANDLES_KEY].key;
    s_op->key_a[1].buffer_sz = Trove_Common_Keys[DIST_DIRDATA_HANDLES_KEY].size;

    s_op->val_a[1].buffer = attr->u.dir.dirdata_handles;
    s_op->val_a[1].buffer_sz = OSASZ(attr->u.dir.dist_dir_attr.dirdata_count,
                                     attr->u.dir.dist_dir_attr.sid_count);
    
    s_op->error_a = (PVFS_error*)calloc(keyval_count, sizeof(PVFS_error));
    if (!s_op->error_a)
    {
        free(attr->u.dir.dist_dir_bitmap);
        free(attr->u.dir.dirdata_handles);
        free(s_op->key_a);
        free(s_op->val_a);
        js_p->error_code = -PVFS_ENOMEM;
        goto error_out;
    }

    js_p->error_code = 0;

    ret = job_trove_keyval_read_list(s_op->req->u.lookup_path.fs_id,
                                     handle,
                                     s_op->key_a,
                                     s_op->val_a,
                                     s_op->error_a,
                                     keyval_count,
                                     0,
                                     NULL,
                                     smcb,
                                     0,
                                     js_p,
                                     &j_id,
                                     server_job_context,
                                     s_op->req->hints);

    return ret;


error_out:
    if ( attr->u.dir.dist_dir_bitmap )
    {
       free( attr->u.dir.dist_dir_bitmap );
       attr->u.dir.dist_dir_bitmap = NULL;
    }
    if ( attr->u.dir.dirdata_handles )
    {
       free( attr->u.dir.dirdata_handles );
       attr->u.dir.dirdata_handles = NULL;
    }
    if ( s_op->key_a )
    {
       free( s_op->key_a );
       s_op->val_a = NULL;
    }
    if ( s_op->val_a )
    {
       free( s_op->val_a );
       s_op->val_a = NULL;
    }
    if ( s_op->error_a )
    {
       free( s_op->error_a);
       s_op->error_a = NULL;
    }

    return SM_ACTION_COMPLETE;
}/* end lookup_get_dirdata_from_keyval */

/*
 * Function: lookup_compute_directory_entry_location
 *
 * Synopsis: Given a handle for a dspace holding directory entries,
 * look up the current segment and obtain its handle.
 *
 * Clean up the previous read of kv attrs, copoy complete attrs into resp
 * struct.  Compute the handle of the dirdata to search for the segment name
 * in.
 */
static PINT_sm_action lookup_compute_directory_entry_location(
        struct PINT_smcb *smcb,
        job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    int ret = -PVFS_EINVAL;
    PVFS_dist_dir_hash_type dirdata_hash;
    int last_dirdata_sid_index=0;
    int i;

    /* Copy attrs including bitmap and handles from frame into the response. 
     * The rest of this func does not reference the resp copy, only the frame copy
     * but it doesn't update the attributes, so that's ok.*/
    ret = PINT_copy_object_attr(
                &s_op->resp.u.lookup_path.attr_array[s_op->u.lookup.array_index],
                &s_op->u.lookup.attr);
        
    /* find the segment that we should look up in the directory */
    ret = PINT_string_next_segment(s_op->req->u.lookup_path.path,
                                   &s_op->u.lookup.segp,
                                   &s_op->u.lookup.segstate);

    if (ret != 0)
    {
        gossip_lerr("PINT_string_next_segment failed: path: %s\n",
                    s_op->req->u.lookup_path.path);
        js_p->error_code = ret;
        return SM_ACTION_COMPLETE;
    }


    /* find the hash value for that segment */
    dirdata_hash = PINT_encrypt_dirdata(s_op->u.lookup.segp);
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "lookup: encrypt dirdata/dirent %s into hash value %llu.\n",
                   s_op->u.lookup.segp, llu(dirdata_hash));


    /* determine which dirdata handle hosts that segment */
    s_op->u.lookup.dirdata_server_index =
                    PINT_find_dist_dir_bucket(
                                    dirdata_hash,
                                    &s_op->u.lookup.attr.u.dir.dist_dir_attr,
                                    s_op->u.lookup.attr.u.dir.dist_dir_bitmap);

    /* thus, the dirdata handle is 
     * s_op->u.lookup.attr.u.dir.dirdata_handles[dirdata_server_index]
     * and the sids associated with that dirdata handle are
     * s_op->u.lookup.attr.u.dir.dirdata_sids[dirdata_server_index * metasidcnt]...
     *                                       [(dirdata_server_index * metasidcnt) +
     *                                        (metasidcnt - 1)]
     */
    s_op->u.lookup.dirdata_sid_index = (s_op->u.lookup.dirdata_server_index *
                                        s_op->metasidcnt);

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "lookup: selecting bucket No.%d from dist_dir_bitmap.\n",
                   s_op->u.lookup.dirdata_server_index);
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "  need to read from dirdata handle=%s, sid=%s, segment=%s (len=%d)\n",
                   PVFS_OID_str(&s_op->u.lookup.attr.u.dir.dirdata_handles[
                                         s_op->u.lookup.dirdata_server_index]),
                   PVFS_SID_str(&s_op->u.lookup.attr.u.dir.dirdata_sids[
                                         s_op->u.lookup.dirdata_sid_index]),
                   s_op->u.lookup.segp, (int) strlen(s_op->u.lookup.segp));

    /* For that dirdata handle, do any of its sids identify the local machine? 
     * If not, then we start with the first one in the list.  MSGPAIR will access 
     * the other sids, if the first one fails.
     */
    last_dirdata_sid_index = s_op->u.lookup.dirdata_sid_index + s_op->metasidcnt;
    for (i = s_op->u.lookup.dirdata_sid_index; i < last_dirdata_sid_index; i++)
    {
        if (PINT_cached_config_server_local(&s_op->u.lookup.attr.u.dir.dirdata_sids[i]))
        {
           gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "lookup: local server !!!\n");
           js_p->error_code = LOCAL_DIRENT;
           break;
        }
    }

    if ( i == last_dirdata_sid_index )
    {   
        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "lookup: remote server !!!\n");
        js_p->error_code = REMOTE_DIRENT;
    }

    return SM_ACTION_COMPLETE;
}/* lookup_compute_directory_entry_location */


/* Function lookup_read_directory_entry_local
 * Read the desired dirent from the local keyval
 */
static PINT_sm_action lookup_read_directory_entry_local(
        struct PINT_smcb *smcb,
        job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    job_id_t j_id;
    int ret = -PVFS_EINVAL;

    js_p->error_code = 0;

    s_op->key.buffer = s_op->u.lookup.segp;
    s_op->key.buffer_sz = strlen(s_op->u.lookup.segp) + 1;

    /* Read in SID information to temporary location.  Copy back into
     * response array in next state */
    s_op->val.buffer = s_op->u.lookup.temp_dirent_store;

    s_op->val.buffer_sz = OSASZ(1, s_op->metasidcnt);

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "Reading local keyval\n");
    ret = job_trove_keyval_read(s_op->req->u.lookup_path.fs_id,
                                s_op->u.lookup.attr.u.dir.dirdata_handles[
                                          s_op->u.lookup.dirdata_server_index],
                                &s_op->key, 
                                &s_op->val,
                                TROVE_KEYVAL_DIRECTORY_ENTRY,
                                NULL, 
                                smcb, 
                                0, 
                                js_p, 
                                &j_id,
                                server_job_context, 
                                s_op->req->hints);

    return ret;
}

/* Function: lookup_read_directory_entry_remote
 * Read the desired dirent from the keyval on a remote server using mgmt_get_dirent
 */
static PINT_sm_action lookup_read_directory_entry_remote(struct PINT_smcb *smcb,
                                                         job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    PINT_sm_msgpair_state *msg_p = NULL;
    int ret;
    PVFS_capability capability;

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "s_op (%p)\n", s_op);


    PINT_msgpair_init(&s_op->msgarray_op);
    msg_p = &s_op->msgarray_op.msgpair;
    PINT_serv_init_msgarray_params(s_op, s_op->req->u.lookup_path.fs_id);

    PINT_null_capability(&capability);

    PINT_SERVREQ_MGMT_GET_DIRENT_FILL(msg_p->req,
                                      capability,
                                      s_op->req->u.lookup_path.fs_id,
                                      s_op->u.lookup.attr.u.dir.dirdata_handles[
                                                   s_op->u.lookup.dirdata_server_index],
                                      s_op->u.lookup.segp,
                                      NULL);

    PVFS_debug_servreq_mgmt_get_dirent(GOSSIP_LOOKUP_DEBUG, &msg_p->req);

    PINT_cleanup_capability(&capability);

    msg_p->msgclass = PVFS_IO_METADATA;
    msg_p->msgdir = PVFS_IO_READ;
    msg_p->fs_id = s_op->req->u.lookup_path.fs_id;
    msg_p->handle =
        s_op->u.lookup.attr.u.dir.dirdata_handles[
                                          s_op->u.lookup.dirdata_server_index];
        /* dir objects are all metadata so sid counts are the same */
    msg_p->sid_count = s_op->u.lookup.attr.meta_sid_count;
    msg_p->sid_index = 0;
    msg_p->sid_array = &s_op->u.lookup.attr.u.dir.dirdata_sids[
                                                     s_op->u.lookup.dirdata_sid_index];
    msg_p->retry_flag = PVFS_MSGPAIR_RETRY;
    msg_p->comp_fn = lookup_get_dirent_comp_fn;

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "reading remote dirent %s from dirdata handle %s sid %s\n",
                   s_op->u.lookup.segp, PVFS_OID_str(&msg_p->handle),
                   PVFS_SID_str(&msg_p->sid_array[0]));

    ret = PVFS_SID_get_addr(&msg_p->svr_addr, &msg_p->sid_array[0]);
    if (ret)
    {
        gossip_lerr("Failed to map dirdata server address\n");
        js_p->error_code = ret;
        return SM_ACTION_COMPLETE;
    }

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "Push Frame (mop) (%p) and call MPA\n",
                   &s_op->msgarray_op);

    PINT_sm_push_frame(smcb, 0, &s_op->msgarray_op, M_OP);
    js_p->error_code = 0;
    return SM_ACTION_COMPLETE;

    /* calls MPA to run get get_dirent on remote node */
}

/* Completion Function: lookup_get_dirent_comp_fn
 * puts the result of the remote get_dirent into a buffer
 */
static int lookup_get_dirent_comp_fn(void *v_p,
                                     struct PVFS_server_resp *resp_p,
                                     int index)
{
    PINT_smcb *smcb = v_p;
    PINT_smcb *parent_smcb = smcb->parent_smcb;
    PINT_server_op *s_op = PINT_sm_frame(parent_smcb, (PINT_MSGPAIR_PARENT_SM));

    PVFS_debug_servresp_mgmt_get_dirent(GOSSIP_LOOKUP_DEBUG, resp_p);

    assert(resp_p->op == PVFS_SERV_MGMT_GET_DIRENT);

    if (resp_p->status == 0 && resp_p->u.mgmt_get_dirent.error == 0)
    {
        /* copy resp into the s_op - we will overwrite it later
         * this gives us many things not copied below such as
         * dirdata handles and sids, timestamps and permissions
         */
        /* we are completing a mgmt_get_dirent which does NOT return an attr
         * so this makes no sense
         */
        /* PINT_copy_object_attr(&s_op->resp.u.getattr.attr, &resp_p->u.getattr.attr); */

        /* copy handle from the request's response to lookup area */
        s_op->u.lookup.temp_dirent_store[0].oid = resp_p->u.mgmt_get_dirent.handle;

        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "sid count = %d\n",
                       resp_p->u.mgmt_get_dirent.sid_count);

        /* copy sids from the request's response to lookup area */
        memcpy(&s_op->u.lookup.temp_dirent_store[1],
               resp_p->u.mgmt_get_dirent.sid_array,
               SASZ(resp_p->u.mgmt_get_dirent.sid_count));

        s_op->u.lookup.temp_dirent_sid_count = resp_p->u.mgmt_get_dirent.sid_count;

        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                     "Got dirent.handle %s\n",
                     PVFS_OID_str(&resp_p->u.mgmt_get_dirent.handle));
        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                     "Got dirent.sid_array %s\n",
                     PVFS_SID_str(&resp_p->u.mgmt_get_dirent.sid_array[0]));
    }
    return resp_p->u.mgmt_get_dirent.error;
}

/*
 * Function: lookup_read_object_metadata
 *
 * Synopsis: Given an object handle, looks up the attributes
 * (metadata) for that handle.
 *
 * Initializes key and value structures to direct metadata:
 * - if this is the starting (base) handle, store in
 *   s_op->u.lookup.base_attr
 * - otherwise store it in the appropriate slot in the resp handle array
 *
 * Posts the keyval read to trove.
 */
static PINT_sm_action lookup_read_object_metadata(
                                    struct PINT_smcb *smcb,
                                    job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    PVFS_handle handle = PVFS_HANDLE_NULL;
    int i,j,start_index,end_index /*, error_code*/;

    assert(s_op->u.lookup.seg_nr <= s_op->u.lookup.seg_ct);

    PVFS_debug_frame_stack(GOSSIP_LOOKUP_DEBUG, smcb);

    PINT_sm_pop_top_frames(smcb);

    PVFS_debug_frame_stack(GOSSIP_LOOKUP_DEBUG, smcb);
#if 0
    /* there should be a frame on the tos that isn't needed so we should
     * pop it! right now no error checking is done, but we should add it
     * OK, this might work in one situation, but does not in another.
     * One way to fix this is look at the stack detail to decide.
     */
    if (smcb->base_frame < smcb->frame_count - 1)
    {
        /* so this says if there is a frame after the base pop it
         * I don't know if that's right - if we should pop multiples
         */
        PINT_sm_pop_frame(smcb, NULL, &error_code, NULL, NULL);
    }
#endif

    /* A dirent object was found in the keyval db 
     * OR we read a dirent from the keyval of another server
     * Effectively increment lookup.array_index - on a dir we loop back
     * and use the next spot in the resp arrays.  A file is the end anyway.
     */
    s_op->u.lookup.seg_nr++;
    s_op->u.lookup.array_index = s_op->u.lookup.seg_nr - 1;

    /* From the dirdata directory entry, we have a handle representing a
     * dspace object.  We don't know, yet, if this object is a metafile or
     * another directory until we retrieve it.  
     */ 
    handle  = (PVFS_handle)s_op->u.lookup.temp_dirent_store[0].oid;
    /* ds_attr = &(s_op->u.lookup.ds_attr_array[s_op->u.lookup.array_index]); */

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "handle = %s\n", PVFS_OID_str(&handle));

    /* store dirent object in the response structure */
    s_op->resp.u.lookup_path.handle_array[s_op->u.lookup.array_index] = handle; 

    /* not sure what is going on here - looks like we're copying around some sids
     * but which sids. where and why is not clear - and is this the right way
     * to copy them?
     */
    start_index = ((s_op->u.lookup.array_index) * (s_op->metasidcnt));
    end_index   = start_index + s_op->metasidcnt;
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "start_index %d  end_index %d  lookup_path.sid_count %d \n",
                   start_index, end_index,
                   s_op->resp.u.lookup_path.sid_count); /* this is 0 - should not be */
 
    /* This is hard coded to 1 - I assume position 0 is an OID?  not sure
     * what's up with this, needs to be much clearer
     */
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "sid[0] = %s\n", 
                   PVFS_SID_str(&s_op->u.lookup.temp_dirent_store[1].sid));

    /* I think these are the sids for handles that represent the segment in the
     * response.  They wouldn't be anywhere else - the sid lists in the attr are
     * for parents and dirdata and datafiles and such.  Not sure if they are set up
     * to be stored with the handles, we might not know how many there are.
     */
    for (i = start_index, j = 1; i < end_index; i++, j++)
    {
        s_op->resp.u.lookup_path.sid_array[i] =
                                 s_op->u.lookup.temp_dirent_store[j].sid;
        s_op->resp.u.lookup_path.sid_count++;
    }

    /* Does the handle's dspace entry reside locally or remotely?  If remotely,
     * then we are done.
     */
    for (i = start_index, j = 1; i < end_index; i++, j++)
    {
        if (PINT_cached_config_server_local(
                                &(s_op->u.lookup.temp_dirent_store[j].sid)))
        {
            struct PINT_server_op *g_op = malloc(sizeof(*g_op));
            /* set up getattr frame */
            g_op->req = s_op->req;
            g_op->target_handle = handle;
            g_op->target_fs_id = s_op->req->u.lookup_path.fs_id;
            g_op->target_sid_array = s_op->resp.u.lookup_path.sid_array;
            s_op->u.lookup.handle_ct = 1;
            /* push getattr frame */
            PINT_sm_push_frame(smcb, 999, g_op, S_OP);
            /* this object is on this server */
            gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                           "Local Segment s_op->lookup.handle_ct = %u\n",
                           s_op->u.lookup.handle_ct);
            break;
        }
    }
    if (i == end_index)
    {
        /* None of the sids identifies the local server */

        /* But, the handle is valid; it just lives on another server */
        s_op->u.lookup.handle_ct++;
        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "Remote Segment s_op->lookup.handle_ct = %u\n",
                       s_op->u.lookup.handle_ct);

        /* the SM does not look for this, we will go to
         * lookup_verify_metadata_object() in either case.
         * That func doesn't look for it either, so this seems to be
         * rather useless.
         */
        js_p->error_code = REMOTE_SEGMENT;
        return SM_ACTION_COMPLETE;
    }

    /* LOCAL */
    /* Copy the fsid and handle to the s_op structure for prelude/getattr */
    s_op->target_handle = handle;
    s_op->target_fs_id = s_op->req->u.lookup_path.fs_id;

    /* local handle dspace */
    js_p->error_code = LOCAL_SEGMENT;
    return SM_ACTION_COMPLETE; /* complete or deferred */
}

static PINT_sm_action remote_metadata_request(struct PINT_smcb *smcb,
                                             job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    PINT_sm_msgarray_op *getattr_op;
    PINT_sm_msgpair_state *msg_p;
    int ret = -PVFS_EINVAL;
    /* job_id_t j_id; */
    /* PVFS_handle handle = PVFS_HANDLE_NULL; */
    PVFS_capability temp_cap;
    /* PVFS_ds_attributes *ds_attr = NULL; */

    /* not an s_op, but a mop that needs to be setup for MPA
     * Including a request for the getattr.  The mop will
     * hold the SIDs, etc.
     */
    js_p->error_code = 0;

    getattr_op = &s_op->msgarray_op;
    PINT_msgpair_init(getattr_op);
    getattr_op->count = 1;
    getattr_op->index = 0;

    getattr_op->total_size = 0;  /* for now */
    msg_p = &getattr_op->msgpair;

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "s_op (%p) getattr_op (%p) msg_p (%p)\n",
                   s_op, getattr_op, msg_p);

    PINT_server_to_server_capability(&temp_cap,
                                     s_op->req->u.lookup_path.fs_id,
                                     1,
                                     &s_op->resp.u.lookup_path.handle_array[s_op->u.lookup.array_index]);

    PINT_SERVREQ_GETATTR_FILL((getattr_op->msgpair.req),
                              PVFS_REQ_OTHER,
                              temp_cap,
                              s_op->req->u.lookup_path.credential,
                              s_op->req->u.lookup_path.fs_id,
                              s_op->resp.u.lookup_path.handle_array[s_op->u.lookup.array_index],
                              PVFS_ATTR_FASTEST | PVFS_ATTR_CAPABILITY, /* suppress dirent count */
                              NULL);

    msg_p->msgclass = PVFS_IO_METADATA;
    msg_p->msgdir = PVFS_IO_READ;
    msg_p->fs_id = s_op->req->u.lookup_path.fs_id;
    msg_p->handle = s_op->resp.u.lookup_path.handle_array[s_op->u.lookup.array_index];
    msg_p->sid_count = s_op->resp.u.lookup_path.sid_count; /* ??? */
    msg_p->sid_index = 0;
    msg_p->sid_array = &(s_op->u.lookup.temp_dirent_store[1].sid);
    msg_p->retry_flag = PVFS_MSGPAIR_RETRY;
    msg_p->comp_fn = read_remote_metadata_comp_fn;

    ret = PVFS_SID_get_addr(&msg_p->svr_addr, &msg_p->sid_array[0]);
    if (ret)
    {
        gossip_lerr("Failed to map meta server address\n");
        js_p->error_code = ret;
        return SM_ACTION_COMPLETE;
    }

    PVFS_debug_servreq_getattr(GOSSIP_LOOKUP_DEBUG, &getattr_op->msgpair.req);
    PVFS_debug_msgpair_state(GOSSIP_LOOKUP_DEBUG, msg_p);

    PINT_sm_push_frame(smcb, 0, getattr_op, M_OP); /* this is a mop */
    PVFS_debug_frame_stack(GOSSIP_LOOKUP_DEBUG, smcb);

    return SM_ACTION_COMPLETE;


#if 0
    /*This seems to copy the attr on front of array to the getattr
     * Why?  As far as I know getattr doesn't use this and will only
     * overwrite it.  We will let getattr place results in the standard place
     * and then move them to the correct space.
     * Is there a way to redirect getattr to put the result where we want?
     */
    getattr_op->attr = s_op->resp.u.lookup_path.attr_array[
                                               s_op->u.lookup.array_index];

    gossip_lsdebug(GOSSIP_SERVER_DEBUG, "s_op->req (%p) getattr_op->req (%p)\n",
                   s_op->req, getattr_op->req);

    memcpy(getattr_op->req, s_op->req, sizeof(*s_op->req));
    getattr_op->req->op = PVFS_SERV_GETATTR; /* this will be a getattr subreq */
                                     
    getattr_op->u.getattr.fs_id      = s_op->req->u.lookup_path.fs_id;
    getattr_op->u.getattr.handle     = s_op->resp.u.lookup_path.handle_array[
                                                    s_op->u.lookup.array_index ];

    getattr_op->u.getattr.attrmask   = PVFS_ATTR_META_DIST          |
                                       PVFS_ATTR_META_DFILES        |
                                       PVFS_ATTR_META_MIRROR_MODE   |
                                       PVFS_ATTR_CAPABILITY;

    getattr_op->u.getattr.credential = s_op->req->u.lookup_path.credential;

    /* setup for prelude - not here but in the request */

    getattr_op->req->u.getattr.handle = getattr_op->u.getattr.handle;
    getattr_op->req->u.getattr.fs_id = getattr_op->u.getattr.fs_id;
    getattr_op->req->u.getattr.credential = getattr_op->u.getattr.credential;
    PINT_server_to_server_capability(&getattr_op->req->capability,
                                     getattr_op->u.getattr.fs_id,
                                     1,
                                     &getattr_op->u.getattr.handle);
#if 0
    getattr_op->target_sid_array = &(s_op->u.lookup.temp_dirent_store[j].sid);
    getattr_op->target_object_attr = &getattr_op->attr;
#endif

    gossip_lsdebug(GOSSIP_SERVER_DEBUG, "getattr_op.handle %s\n getattr_op.fsid %d\n",
                   PVFS_OID_str(&(getattr_op->req->u.getattr.handle)),
                   getattr_op->req->u.getattr.fs_id);

    ret = PINT_sm_push_frame(smcb, 0, getattr_op, M_OP);
    js_p->error_code = ret;

    if ( ret < 0 )
    {
        gossip_err("Error pushing getattr frame onto lookup stack:ret %d \n", ret);
        free(getattr_op->req);
        free(getattr_op);
        js_p->error_code = ret;
        return SM_ACTION_COMPLETE;
    }

    js_p->error_code = 0;
    return SM_ACTION_COMPLETE;
/************** END of new code ***************/

    return ret;
#endif
}

/* completes a REMOTE call by copying the attributes into the parent frame
 */
static int read_remote_metadata_comp_fn(void *v_p, struct PVFS_server_resp *resp_p, int i)
{
    PINT_smcb *smcb = v_p;
    PINT_smcb *parent_smcb = smcb->parent_smcb;
    PINT_server_op *p_op = PINT_sm_frame(parent_smcb, PINT_FRAME_PARENT);

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "parent frame (%p)\n", p_op);
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "resp_p (%p)\n", resp_p);

    PVFS_debug_frame_stack(GOSSIP_LOOKUP_DEBUG, smcb);
    PVFS_debug_frame_stack(GOSSIP_LOOKUP_DEBUG, parent_smcb);

    PINT_copy_object_attr(&p_op->attr, &resp_p->u.getattr.attr);

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "resp_p->u.getattr.attr.objtype %d\n", resp_p->u.getattr.attr.objtype);
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "p_op->attr.objtype %d\n", p_op->attr.objtype);

    return 0;
}

/* Function: cleanup_remote_request
 *
 * Synopsis: This function pops the mop on the stack after a MPA
 * call to getattr.  Any useful data in the mo should be handled
 * by the comp_fn.
 */
static PINT_sm_action cleanup_remote_request(struct PINT_smcb *smcb,
                                             job_status_s *js_p)
{
    PINT_sm_msgarray_op *getattr_op = NULL;
    PINT_server_op *s_op = NULL;
    int task_id;
    int remaining;

    PVFS_debug_frame_stack(GOSSIP_LOOKUP_DEBUG, smcb);

    /* pop the mop on top */
    getattr_op = PINT_sm_pop_frame(smcb, &task_id, &js_p->error_code, &remaining, NULL);
    /* now grab the parent s_op */
    s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    /* save the mop ?
     * we already copied the resp from the mop to the sop
     * and the mop is actually part of the sop? yes
     * maybe we don't need to do this - no I don't think so
     */
    /*s_op->u.lookup.temp_getattr_op = getattr_op;*/

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "s_op (%p) getattr_op (%p)\n",
                  s_op, getattr_op);

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "s_op->attr.objtype %d\n",
                  s_op->attr.objtype);

    return SM_ACTION_COMPLETE;
}

/*
 * Function: lookup_verify_object_metadata
 *
 * Synopsis: Examine the metadata returned from the prelude sm.  If
 * the metadata is for a directory, prepare to read the handle of the
 * next segment, if there is one.  If the metadata is for a file,
 * prepare to send a response.
 *
 * If the object is a directory, this function sets the
 * s_op->u.lookup.segp value to point to the next segment to look up;
 * this is used in lookup_read_directory_entry.
 *
 * This function does not post an operation, but rather returns 1
 * immediately.
 */
static PINT_sm_action lookup_verify_object_metadata(struct PINT_smcb *smcb,
                                                    job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    struct PINT_sm_msgarray_op *getattr_op;
    PVFS_object_attr *a_p = NULL; /* convenience for debug */

    PVFS_debug_frame_stack(GOSSIP_LOOKUP_DEBUG, smcb);

    /* remove getattr frame - already removed */
    /* getattr_op = PINT_sm_pop_frame(smcb, &task_id, &js_p->error_code, &remaining, NULL); */
    /* getattr_op = &s_op->msgarray_op; - didn't save mop */

    getattr_op = &s_op->msgarray_op;

    if ( js_p->error_code )
    {
        goto errorout;
    }

    /* get current frame for this SM */
    s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "s_op (%p) getattr_op (%p)\n",
                   s_op, getattr_op);


    /* update our successful handle read count */
    /* is this a dup handle_ct incr?  This is done during read_object_meetadata
     * and we are getting 2x the correct count
     */
    /* s_op->u.lookup.handle_ct++; */
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "s_op lookup.handle_ct = %u\n",
                   s_op->u.lookup.handle_ct);

    /* setup local variables. 
     * convert dspace attrs into sysint attrs.
     * This copy is supposed to set up get_dirdata_from_kv
     */

/************/
/* Both forms of attr are in s_op now using SM getattr.
 * We can copy the ds_attr into this array if its needed
 * The object attr needs to be copied as well, we should
 * also do that here  (see stmt above and below)
 * s_op->attr and s_op->ds_attr should have each type.
 * attr should be copied to the lookup resp attr array,
 * ds_attr to lookup storage array s_op as shown below.
 */
/************/

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "index %d attr_array (%p) ds_attr_array (%p)\n",
                   s_op->u.lookup.array_index,
                   s_op->resp.u.lookup_path.attr_array,
                   s_op->u.lookup.ds_attr_array);

    /* copy return from attr into resp attr array */
    PINT_copy_object_attr(&(s_op->resp.u.lookup_path.attr_array[s_op->u.lookup.array_index]),
                          &(s_op->attr));
    /* a_p now points to this copy */
    a_p = &(s_op->resp.u.lookup_path.attr_array[s_op->u.lookup.array_index]); 

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "a_p (%p) a_p->objtype %d\n",
                   a_p, a_p->objtype);

    /* I don't think we need this */
    /*s_op->u.lookup.ds_attr_array[s_op->u.lookup.array_index] = getattr_op->ds_attr; */

    /* set target_object_attr for processing in permissions checks, if 
     * this check is needed.
     */
    s_op->target_object_attr = a_p;

    assert(((a_p->objtype == PVFS_TYPE_DIRECTORY) ||
            (a_p->objtype == PVFS_TYPE_METAFILE)  ||
            (a_p->objtype == PVFS_TYPE_SYMLINK)));

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "attrs = (owner = %d, group = %d, perms = %o, type = %d)\n",
                   a_p->owner, a_p->group, a_p->perms, a_p->objtype);

    /* if we hit a metafile in local dspace db,
     * then we know additional attributes are in the
     * local keyval db.  So, lets return what we can.
     */
    if (a_p->objtype == PVFS_TYPE_METAFILE)
    {
        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "object is a metafile; "
                       "gathering keyval attributes from local server.....\n");

        js_p->error_code = LOOKUP_LOCAL_METAFILE_KEYVALS;
        goto errorout;

        /* sends SM to get attr for the file and end */
    }

    /*
     * if we hit a symlink, we're done; client will pick up the pieces
     * and continue to resolve the symlink if required
     */
    if (a_p->objtype == PVFS_TYPE_SYMLINK)
    {
        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "object is a symlink; "
                     "halting lookup and sending response\n");

        /* This is not recognized by the state machine.  This would look back
         * to the top the same as other dirs but without checking perms.  Not sure if
         * that's right for a symlink.
         */
        js_p->error_code = STATE_ENOTDIR;
        goto errorout;
    }

    gossip_if(GOSSIP_LOOKUP_DEBUG)
    {
        /* DIRECTORY by default at this point */
        gossip_lsadebug("object is a directory; dir_dir_attrs: tree_ht %u dd min %u, "
                        "ddmax %u dd_cnt %u sid_cnt %u bit_sz %d\n",
                        a_p->u.dir.dist_dir_attr.tree_height,
                        a_p->u.dir.dist_dir_attr.dirdata_min,
                        a_p->u.dir.dist_dir_attr.dirdata_max,
                        a_p->u.dir.dist_dir_attr.dirdata_count,
                        a_p->u.dir.dist_dir_attr.sid_count,
                        a_p->u.dir.dist_dir_attr.bitmap_size);
        gossip_lsadebug("directory lists; handles (%p) sids (%p) bitmap (%p)\n",
                        a_p->u.dir.dirdata_handles,
                        a_p->u.dir.dirdata_sids,
                        a_p->u.dir.dist_dir_bitmap);
   
        gossip_lsadebug("s_op lookup.handle_ct = %u\n", s_op->u.lookup.handle_ct);
        gossip_lsadebug("s_op lookup.attr_ct = %u\n", s_op->u.lookup.attr_ct);
    }
    gossip_end;

    /* if we looked up all the segments, we are done */
    if (s_op->u.lookup.seg_nr == s_op->u.lookup.seg_ct)
    {
        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                       "no more segments in path; sending response\n");

        /* This is not recognized by the state machine.  This would loop back
         * to get_dirdata_from_kv the same as other dirs but without checking perms.
         */
        js_p->error_code = STATE_NOMORESEGS;
        goto errorout;
    }

    /* if we reach this point, the object is a directory. If this is not 
     * the first segment being looked up on this server, check permissions
     * by going to the check_perms state. (The first segment is checked when
     * the capability is checked by the prelude.)
     */
    if (s_op->u.lookup.seg_nr > 0)
    {
        js_p->error_code = LOOKUP_CHECK_PERMS;
        goto errorout;
    }

errorout:

    /* only the first dir should loop back here */
    return SM_ACTION_COMPLETE;
}

/*
 * Function: lookup_setup_getattr_request
 *
 * Synopsis: The object we are now processing is a
 * metafile and we know that its
 * keyval entries are on the local server as well.  
 * So, lets setup a getattr request
 * that will return as many keyval attributes as possible.
 *
 */
static PINT_sm_action lookup_setup_getattr_request(
        struct PINT_smcb *smcb,
        job_status_s *js_p)
{
    int ret;
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    struct PINT_server_op *getattr_op;

    js_p->error_code = 0;

    getattr_op = calloc(1,sizeof(*getattr_op));
    if ( !getattr_op )
    {
        js_p->error_code = -PVFS_ENOMEM;
        return SM_ACTION_COMPLETE;
    }

   
    getattr_op->attr = s_op->resp.u.lookup_path.attr_array[
                                               s_op->u.lookup.array_index];

    getattr_op->req = s_op->req;

    getattr_op->u.getattr.fs_id      = s_op->req->u.lookup_path.fs_id;
    getattr_op->u.getattr.handle     = s_op->resp.u.lookup_path.handle_array[
                                                    s_op->u.lookup.array_index ];
    getattr_op->u.getattr.attrmask   = PVFS_ATTR_META_DIST          |
                                       PVFS_ATTR_META_DFILES        |
                                       PVFS_ATTR_META_MIRROR_MODE   |
                                       PVFS_ATTR_CAPABILITY;
    getattr_op->u.getattr.credential = s_op->req->u.lookup_path.credential;

    /* getattr expects handle, fs_id, and such in the req
     * This doesn't put them there, so I'm adding it.
     */
    getattr_op->req->op = PVFS_SERV_GETATTR;
    getattr_op->req->u.getattr.fs_id = getattr_op->u.getattr.fs_id;
    getattr_op->req->u.getattr.handle = getattr_op->u.getattr.handle;
    getattr_op->req->u.getattr.attrmask = getattr_op->u.getattr.attrmask;
    getattr_op->req->u.getattr.credential = getattr_op->u.getattr.credential;
    PVFS_REQ_COPY_CAPABILITY(s_op->req->capability, *getattr_op->req); 

    ret = PINT_sm_push_frame(smcb, 0, getattr_op, M_OP);
    if ( ret < 0 )
    {
        gossip_lerr("Error pushing getattr frame onto lookup stack:ret(%d)\n", ret);
        free(getattr_op);
        js_p->error_code = ret;
        return SM_ACTION_COMPLETE;
    }

    return SM_ACTION_COMPLETE;

    /* jumps to a getattr */

}/*end lookup_setup_getattr_request*/

/*
 * Function: lookup_verify_getattr_results
 *
 * Synopsis: This getattr request is returning keyval entries for a metafile object.
 * Check the results and update local variables as necessary.
 *
 */
static PINT_sm_action lookup_verify_getattr_results(struct PINT_smcb *smcb,
                                                    job_status_s *js_p)
{
    struct PINT_server_op *getattr_op;
    struct PINT_server_op *s_op;
    int task_id;
    int remaining;
    int ret;
    PVFS_object_attr *resp_attr;

    getattr_op = PINT_sm_pop_frame(smcb, &task_id, &js_p->error_code, &remaining, NULL);

    if ( js_p->error_code )
    {
        goto out;
    }

    s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "s_op (%p) getattr_op (%p)\n",
                   s_op, getattr_op);

    resp_attr = &(getattr_op->resp.u.getattr.attr);

    gossip_if(GOSSIP_LOOKUP_DEBUG)
    {
        gossip_lsadebug("attr: %p\n", resp_attr);
        gossip_lsadebug("objtype: %d\n", resp_attr->objtype);
        gossip_lsadebug("dcount: %d\n", resp_attr->u.dir.dist_dir_attr.dirdata_count);
        gossip_lsadebug("scount: %d\n", resp_attr->u.dir.dist_dir_attr.sid_count);
        gossip_lsadebug("serno: %d\n", resp_attr->u.dir.dist_dir_attr.server_no);
    }
    gossip_end;

    ret = PINT_copy_object_attr(&s_op->resp.u.lookup_path.attr_array[
                                              s_op->u.lookup.array_index],
                                resp_attr);
    if (ret)
    {
        gossip_lerr("Error copying metafile attributes from getattr to lookup:ret(%d)\n", ret);
        js_p->error_code = ret;
        goto out;
    }

out:
    free(getattr_op);
    return SM_ACTION_COMPLETE;
}/*end lookup_verify_getattr_results*/

/*                                                              
 * Function: lookup_check_perms
 * 
 * Synopsis: check to see whether the requesting user has permission to do
 * the lookup. This function checks the file mode (i.e. mask). If the file
 * mode doesn't provide permission, the SM will proceed to the check_acls
 * state.
 */
static PINT_sm_action lookup_check_perms(struct PINT_smcb *smcb,
                                         job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    PVFS_object_attr *a_p = s_op->target_object_attr;
    PVFS_credential *cred = &(s_op->req->u.lookup_path.credential);
    PVFS_uid uid;
    PVFS_gid group_array[PVFS_REQ_LIMIT_GROUPS];
    uint32_t op_mask, num_groups;
    char mask_buf[16] __attribute__((unused));
    int ret;

    /* If we get here with an invalid fsid and handle, we have to
     * return -PVFS_EACCESS 
     */
    if (s_op->target_fs_id == PVFS_FS_ID_NULL ||
        !PVFS_OID_cmp(&s_op->target_handle, &PVFS_HANDLE_NULL))
    {
        js_p->error_code = -PVFS_EACCES;
        return SM_ACTION_COMPLETE;
    }

    assert(a_p);

    js_p->error_code = 0;

    /* map the user using security */
    ret = PINT_map_credential(cred, &uid, &num_groups, group_array);
    if (ret != 0)
    {
        js_p->error_code = ret;
        return SM_ACTION_COMPLETE;
    }

    PINT_debug_credential(cred,
                          "  lookup_check_perms",
                          uid,
                          num_groups,
                          group_array);

#ifdef ENABLE_SECURITY_CERT
    op_mask = 0;
    /* no capabilities for unsigned credential */
    if (!IS_UNSIGNED_CRED(cred))
    {
#endif
    /* retrieve the capabilities of the credential as a mask */
    ret = PINT_get_capabilities(NULL,
                                0,
                                uid,
                                group_array,
                                num_groups, 
                                a_p,
                                &op_mask);

    if (ret != 0)
    {
        /* Currently PINT_get_capabilities only returns 0 unless ACLs are 
         * being checked. This code is provided for future-proofing.
         */
        gossip_lerr("lookup_check_perms: could not retrieve permissions mask (%d)\n", ret);
        js_p->error_code = -PVFS_EINVAL;
        return SM_ACTION_COMPLETE;
    }
#ifdef ENABLE_SECURITY_CERT
    } /* if */
#endif

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "lookup_check_perms: op mask = %s\n",
                   PINT_print_op_mask(op_mask, mask_buf));
    
    /* must have executable permission */
    if ((op_mask & PINT_CAP_EXEC) == 0)
    {
        /* no file-mode permission--check ACLs */
#ifdef ENABLE_SECURITY_CERT
        /* don't check ACLs for unsigned cred */
        js_p->error_code = IS_UNSIGNED_CRED(cred) ? 0 : LOOKUP_CHECK_DIR_ACLS;
#else
        js_p->error_code = LOOKUP_CHECK_DIR_ACLS;
#endif
        return SM_ACTION_COMPLETE;
    }

    return SM_ACTION_COMPLETE;
}

/* Function: lookup_read_acls 
 *
 * Synopsis: Post a keyval DB read of the posix acls to check and see if 
 * directory traversal is allowed or not
 */
static PINT_sm_action lookup_read_directory_acls(struct PINT_smcb *smcb,
                                                 job_status_s* js_p)
{
    int ret = -PVFS_EINVAL;
    job_id_t j_id;
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);

    /* If we get here with an invalid fsid and handle, we have to
     * return -PVFS_EACCESS 
     */
    if (s_op->target_fs_id == PVFS_FS_ID_NULL ||
        !PVFS_OID_cmp(&s_op->target_handle, &PVFS_HANDLE_NULL))
    {
        js_p->error_code = -PVFS_EACCES;
        return SM_ACTION_COMPLETE;
    }
    js_p->error_code = 0;

    memset(&s_op->key, 0, sizeof(PVFS_ds_keyval));
    memset(&s_op->val, 0, sizeof(PVFS_ds_keyval));
    s_op->key.buffer = "system.posix_acl_access";
    s_op->key.buffer_sz = strlen(s_op->key.buffer) + 1;
    s_op->val.buffer = (char *) malloc(PVFS_REQ_LIMIT_VAL_LEN);
    if (!s_op->val.buffer)
    {
        js_p->error_code = -PVFS_ENOMEM;
        return SM_ACTION_COMPLETE;
    }
    s_op->val.buffer_sz = PVFS_REQ_LIMIT_VAL_LEN;

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "About to retrieve acl keyvals for handle %s\n",
                   PVFS_OID_str(&s_op->target_handle));

    /* Read acl keys */
    ret = job_trove_keyval_read(s_op->target_fs_id,
                                s_op->target_handle,
                                &s_op->key,
                                &s_op->val,
                                0,
                                NULL,
                                smcb,
                                0,
                                js_p,
                                &j_id,
                                server_job_context,
                                s_op->req->hints);

    return ret;
}
/* 
 * Function lookup_check_acls
 *
 * Synopsis: check to see whether the requesting user has permission to do
 * the lookup. This function checks POSIX ACLs.
 */
static PINT_sm_action lookup_check_acls(
        struct PINT_smcb *smcb, job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    PVFS_object_attr *a_p = s_op->target_object_attr;
    PVFS_credential *cred = &(s_op->req->u.lookup_path.credential);
    PVFS_uid uid;
    PVFS_gid group_array[PVFS_REQ_LIMIT_GROUPS];
    uint32_t op_mask, num_groups;
    char mask_buf[16] __attribute__ ((unused));
    int ret;

    assert(a_p);

    if (s_op->val.read_sz == 0)
    {
        /* No ACLs available--return EACCES */
        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "lookup_check_acls: no acls\n");
        js_p->error_code = -PVFS_EACCES;
        goto cleanup;
    }

    ret = PINT_map_credential(cred, &uid, &num_groups, group_array);
    if (ret != 0)
    {
        js_p->error_code = -PVFS_EACCES;
        goto cleanup;
    }

    /* get the op mask given the ACLs */
    ret = PINT_get_capabilities(s_op->val.buffer,
                                s_op->val.read_sz, 
                                uid,
                                group_array,
                                num_groups,
                                a_p,
                                &op_mask);

    if (ret != 0)
    {
        /* unexpected error */
        gossip_lerr("lookup_check_acls: could not retrieve permissions mask (%d)\n", ret);
        js_p->error_code = -PVFS_EINVAL;
        goto cleanup;
    }

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "lookup_check_acls: op mask = %s\n",
                 PINT_print_op_mask(op_mask, mask_buf));

    /* must have executable permission */
    if ((op_mask & PINT_CAP_EXEC) == 0)
    {
        js_p->error_code = -PVFS_EACCES;
        goto cleanup;
    }

    /* success if we get here */
    js_p->error_code = 0;

cleanup:
    free(s_op->val.buffer);

    return SM_ACTION_COMPLETE;
}

/* Function: lookup_setup_resp
 * Setup the response for the lookup_path to be returned to the client
 * This funnc primatily sets  up the counts for handles, sids, and attrs
 * The arrays are set up in the resp during the processing of the request.
 */
static PINT_sm_action lookup_setup_resp(struct PINT_smcb *smcb,
                                        job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);

    /*
     * NOTE: we may have handle_count N and sid_count N*metasidcnt
     * with attr_count N-1 in the case that another meta-server needs to 
     * continue with the path (attr) lookup.  otherwise, we're returning 
     * N handles, N*metasidcnt, and  N attrs.
     */
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "Begin: s_op (%p) s_op->lookup.handle_ct %u s_op->decoded.enc_type %d\n",
                   s_op, s_op->u.lookup.handle_ct, s_op->decoded.enc_type);
    s_op->resp.u.lookup_path.handle_count = s_op->u.lookup.handle_ct;
    s_op->resp.u.lookup_path.attr_count   = s_op->u.lookup.attr_ct;
    s_op->resp.op = s_op->req->op;

    if (s_op->resp.u.lookup_path.handle_count ||
        s_op->resp.u.lookup_path.attr_count)
    {
        js_p->error_code = 0;
    }
    else if (js_p->error_code < 0)
    {
        /* preserve error code in this case and fall through */
        gossip_debug(GOSSIP_LOOKUP_DEBUG, "lookup error in previous step\n");
    }
    else
    {
        js_p->error_code = -PVFS_ENOENT;
    }

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG,
                   "sending '%s' response with %u handle(s) and %u attr(s)\n",
                   (js_p->error_code ? "error" : "success"),
                   s_op->resp.u.lookup_path.handle_count,
                   s_op->resp.u.lookup_path.attr_count);

    /* end timer */
    PINT_perf_timer_end(PINT_server_tpc, PINT_PERF_TLOOKUP, &s_op->start_time);

    if (js_p->error_code == 0)
    {
        /* is this debug assuming handle count is > 0 - not assured - the comment
         * isn't clear whether they assume handle_count can be -1 - it can't because
         * it is unsigned - or if the result of the index calculation can be.
         * This PINT_ACCESS_DEBUG calls PINT_map_server_op_to_string(op).
         */
        PINT_ACCESS_DEBUG(s_op,
                          GOSSIP_ACCESS_DEBUG,
                          "path: %s, handle: %s\n", 
                          s_op->req->u.lookup_path.path, 
                          PVFS_OID_str(&s_op->resp.u.lookup_path.handle_array[
                                   s_op->resp.u.lookup_path.handle_count - 1]));
    }                               /* handle_count -1 or 0 */
    else
    {
        PINT_ACCESS_DEBUG(
            s_op, GOSSIP_ACCESS_DEBUG, "path: %s, lookup failed\n", 
            s_op->req->u.lookup_path.path);
    }

    PVFS_debug_servresp_lookup_path(GOSSIP_LOOKUP_DEBUG, &s_op->resp);

    int i;
    for (i = 0; i < s_op->resp.u.lookup_path.sid_count; i++)
    {
        gossip_lsdebug(GOSSIP_LOOKUP_DEBUG
                       ,"sid[%d] = (%s)\n" ,i
                       ,PVFS_SID_str(&s_op->resp.u.lookup_path.sid_array[i]));
    }
    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "End: s_op (%p) s_op->decoded.enc_type %d\n",
                   s_op, s_op->decoded.enc_type);

    return SM_ACTION_COMPLETE;
}

/*
 * Function: lookup_cleanup
 *
 * Synopsis: Free memory allocated during request processing.
 *
 * There are a bunch of regions that must be freed after processing
 * completes:
 * - decoded request (s_op->decoded)
 * - encoded request (s_op->unexp_bmi_buff.buffer)
 * - encoded response (s_op->encoded)
 * - original (decoded) response (s_op->resp)
 * - dynamically allocated space (in this case 
 *   s_op->resp.u.lookup_path.handle_array)
 * - the server operation structure itself
 */
static PINT_sm_action lookup_cleanup(struct PINT_smcb *smcb, job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);

    gossip_lsdebug(GOSSIP_LOOKUP_DEBUG, "Cleaning up\n");

    if (s_op->resp.u.lookup_path.handle_array)
    {
        free(s_op->resp.u.lookup_path.handle_array);
        s_op->resp.u.lookup_path.handle_array = NULL;
    }

    if (s_op->u.lookup.ds_attr_array)
    {
        free(s_op->u.lookup.ds_attr_array);
        s_op->u.lookup.ds_attr_array = NULL;
    }

    free(s_op->u.lookup.temp_dirent_store);
    s_op->u.lookup.temp_dirent_store = NULL;

    free(s_op->u.lookup.attr.u.dir.dist_dir_bitmap);
    s_op->u.lookup.attr.u.dir.dist_dir_bitmap = NULL;
    free(s_op->u.lookup.attr.u.dir.dirdata_handles);
    s_op->u.lookup.attr.u.dir.dirdata_handles = NULL;

    free(s_op->key_a);
    s_op->key_a = NULL;
    free(s_op->val_a);
    s_op->val_a = NULL;
    free(s_op->error_a);
    s_op->error_a = NULL;

    return(server_state_machine_complete(smcb));
}

/* SM methods
 */
static int perm_lookup(PINT_server_op *s_op)
{
    int ret;

    if (s_op->req->capability.op_mask & PINT_CAP_EXEC)
    {
        ret = 0;
    }
    else
    {
        ret = -PVFS_EACCES;
    }

    return ret;
}
PINT_GET_CREDENTIAL_DEFINE(lookup_path);
PINT_GET_OBJECT_REF_DEFINE(lookup_path);

struct PINT_server_req_params pvfs2_lookup_params = 
{
    .string_name = "lookup",
    .perm = perm_lookup,
/*    .access_type = PINT_server_req_readonly, */
    .sched_policy = PINT_SERVER_REQ_SCHEDULE,
    .get_credential = PINT_get_credential_lookup_path,
    .get_object_ref = PINT_get_object_ref_lookup_path,
    .state_machine = &pvfs2_lookup_sm
};


/*
