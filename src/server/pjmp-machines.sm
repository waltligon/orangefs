%%
machine pvfs2_pjmp_set_attr_work_sm
{
    state pjmp_set_attr_work_initialize
    {
        run pjmp_initialize;
        default => pjmp_call_set_attr_work_sm;
    }

    state pjmp_call_set_attr_work_sm
    {
        jump pvfs2_set_attr_with_prelude_sm;
        default => pjmp_set_attr_release_job;
    }

    state pjmp_set_attr_release_job
    {
        run pjmp_release_job;
        default => pjmp_set_attr_work_execute_terminate;
    }

    state pjmp_set_attr_work_execute_terminate
    {
        run pjmp_execute_terminate;
        default => terminate;
    }
}

/* tree_get_dirent_count ends at leaves which are local
 * This is all we should need for the local op
 */
/* Local get dirent count called by pjmp
 */
machine pvfs2_pjmp_get_dirent_count_sm
{
    state pjmp_get_dirent_count_work_init
    {
        run pjmp_get_dirent_count_work_init;
        default => pjmp_get_dirent_count_work_finish;
    }

    state pjmp_get_dirent_count_work_finish
    {
        run pjmp_get_dirent_count_work_finish;
        default => pjmp_get_dirent_count_terminate;
    }

    state pjmp_get_dirent_count_terminate
    {
        run pjmp_execute_terminate;
        default => terminate;
    }
}

/*
 * Callled by tree code these are local operations
 * jump pvfs2_get_attr_with_prelude_sm;
 */
machine pvfs2_pjmp_get_attr_work_sm
{
    state pjmp_get_attr_work_initialize
    {
        run pjmp_get_attr_work_init;
        default => pjmp_call_get_attr_work;
    }

    state pjmp_call_get_attr_work
    {
        jump pvfs2_get_attr_work_sm;
        default => pjmp_get_attr_release_job;
    }

    state pjmp_get_attr_release_job
    {
        run pjmp_release_job;
        default => pjmp_get_attr_work_execute_terminate;
    }

    state pjmp_get_attr_work_execute_terminate
    {
        run pjmp_execute_terminate;
        default => terminate;
    }
}


