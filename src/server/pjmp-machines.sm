}

/*
machine pvfs2_pjmp_get_attr_sm
{
    state pjmp_initialize
    {
        run pjmp_initialize;
        default => pjmp_call_get_attr;
    }

    state pjmp_call_get_attr
    {
        jump pvfs2_get_attr_sm;
        default => pjmp_execute_terminate;
    }

    state pjmp_execute_terminate
    {
        run pjmp_execute_terminate;
        default => terminate;
    } 
}
*/

machine pvfs2_pjmp_call_msgpairarray_sm
{
    state call_msgpairarray
    {
        run call_msgpairarray;
        success => transfer_msgpair;
        default => cleanup_msgpairarray;
    }

    state transfer_msgpair
    {
        jump pvfs2_msgpairarray_sm;
        default => cleanup_msgpairarray;
    }

    state cleanup_msgpairarray
    {
        run cleanup_msgpairarray;
        default => terminate;
    }
} /*end state machine pvfs2_pjmp_call_msgpairarray_sm*/
%%

/* generic initialize
 */
static PINT_sm_action pjmp_initialize(struct PINT_smcb *smcb,
                                      job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    gossip_lsdebug(GOSSIP_MSGPAIR_DEBUG, "Running initialize\n");
    /* keep code from looping through get_item */
    if ((s_op->req->op == PVFS_SERV_TREE_GET_DIRENT_COUNT) ||
        (s_op->req->op == PVFS_SERV_TREE_GET_FILE_SIZE))
    {
        s_op->u.getattr.attrmask &= ~PVFS_ATTR_LATEST;
        s_op->u.getattr.attrmask |=  PVFS_ATTR_FASTEST;
        js_p->error_code = 0;
    }
    return SM_ACTION_COMPLETE;
}

/* getattr specific initialize
 */
static PINT_sm_action pjmp_get_attr_work_init (struct PINT_smcb *smcb,
                                               job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    struct PINT_server_op *p_op = PINT_sm_frame(smcb, PINT_FRAME_PARENT);
    gossip_lsdebug(GOSSIP_MSGPAIR_DEBUG, "Running pjmp getattr initialize\n");
    PINT_copy_object_attr(&s_op->attr, &p_op->attr);
    s_op->u.getattr.handle = p_op->u.getattr.handle;
    s_op->u.getattr.fs_id = p_op->u.getattr.fs_id;
    /* this is a leaf keep tree code from looping through get_item */
    s_op->attr.mask &= ~PVFS_ATTR_LATEST;
    s_op->attr.mask |=  PVFS_ATTR_FASTEST;
    js_p->error_code = 0;
    return SM_ACTION_COMPLETE;
}

static PINT_sm_action pjmp_release_job(struct PINT_smcb *smcb, job_status_s *js_p)
{
    int ret = -1;
    job_id_t tmp_id;
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    gossip_lsdebug(GOSSIP_MSGPAIR_DEBUG, "Running release job\n");

    ret = job_req_sched_release( s_op->scheduled_id
                                ,smcb
                                ,0
                                ,js_p
                                ,&tmp_id
                                ,server_job_context);

    return ret;
}/*end pjmp_release_job*/

static PINT_sm_action pjmp_execute_terminate( struct PINT_smcb *smcb
                                            , job_status_s *js_p)
{
    gossip_lsdebug(GOSSIP_MSGPAIR_DEBUG, "Running terminate\n");
    return SM_ACTION_TERMINATE;
}

/****************************************************************************/
/* Actions for local operations                                             */
/****************************************************************************/

/* This is called for every new task generated by the pjmp
 * It does not need to handle multiple tasks
 */
static PINT_sm_action pjmp_get_dirent_count_work_init(struct PINT_smcb *smcb,
                                                      job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    struct PINT_server_op *p_op GCC_UNUSED
                         = PINT_sm_frame(smcb, PINT_FRAME_PARENT);
    struct PINT_server_tree_communicate_op *tc = &s_op->u.tree_communicate;
    PINT_sm_action sm_status = SM_ACTION_COMPLETE;
    int i = tc->local_index;

    /* the local op needs:*/
    gossip_lsdebug(GOSSIP_SERVER_DEBUG, "handle[%d] (%p) fs_id %d\n",
                   i, &tc->handle_array_local[i], s_op->target_fs_id);
    gossip_lsdebug(GOSSIP_SERVER_DEBUG, "Reading dspace for %s\n",
                   PVFS_OID_str(&tc->handle_array_local[i]));
    gossip_lsdebug(GOSSIP_SERVER_DEBUG, "Parent dirent_count is %ld\n",
                   p_op->attr.u.dir.dirent_count);
    gossip_lsdebug(GOSSIP_SERVER_DEBUG, "s_op (%p) smcb->op (%d) s_op->op %d\n",
                   s_op, smcb->op, s_op->op);

    /* Trove checks a cache for us first
     */
    sm_status = job_trove_dspace_getattr(s_op->target_fs_id,
                                         tc->handle_array_local[i],
                                         smcb,
                                         &tc->ds_attr,
                                         0,
                                         js_p,
                                         &tc->tmp_id,
                                         server_job_context,
                                         s_op->req->hints);

    return sm_status;
}

static PINT_sm_action pjmp_get_dirent_count_work_finish(struct PINT_smcb *smcb,
                                                        job_status_s *js_p)
{
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);
    struct PINT_server_op *p_op = PINT_sm_frame(smcb, PINT_FRAME_PARENT);
    PINT_sm_action sm_status = SM_ACTION_COMPLETE;

    /* getattr for a dirdata should have completed */
    if (js_p->error_code == 0)
    {
        gossip_lsdebug(GOSSIP_SERVER_DEBUG, "adding dirent_count %ld (%p) to parent frame %ld (%p)\n",
                       s_op->u.tree_communicate.ds_attr.u.dirdata.dirent_count,
                       s_op,
                       p_op->resp.u.getattr.attr.u.dir.dirent_count,
                       p_op);
        /* finished correctly - add dirent_count to parent frame */
        p_op->resp.u.getattr.attr.u.dir.dirent_count +=
                       s_op->u.tree_communicate.ds_attr.u.dirdata.dirent_count;
    }
    else
    {
        /* error */
        gossip_lsdebug(GOSSIP_SERVER_DEBUG, "dspace getattr failed %d\n",
                       js_p->error_code);
    }
    return sm_status;
    /* js_p->error_code passes through */
}

/****************************************************************************/
/* Actions for pvfs2_pjmp_call_msgpairarray_sm                              */
/****************************************************************************/

/* We use a separate nested state machine to call msgpairarray because */
/* msgpairarray.sm is setup to work only with a "jump".  When "pjmp"   */
/* is used, the frame stack gets corrupted.                            */
static PINT_sm_action call_msgpairarray (struct PINT_smcb *smcb
                                        ,job_status_s *js_p)
{   
    struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);

    gossip_lsdebug(GOSSIP_MSGPAIR_DEBUG,
                   "op num %d op %s frame (%p) frame count %d base frame %d remt_join_sz (%p)\n",
                   smcb->op, PINT_map_server_op_to_string(smcb->op),
                   s_op, smcb->frame_count, smcb->base_frame,
                   s_op->u.tree_communicate.remote_join_size);

    js_p->error_code = 0;

    gossip_lsdebug(GOSSIP_MSGPAIR_DEBUG, "s_op->msgarray_op.msgpair.req.op:%d\n",
                   s_op->msgarray_op.msgpair.req.op);

    /* PINT_sm_push_frame(smcb, 0, &s_op->msgarray_op.msgpair.req.op); */
    PINT_sm_push_frame(smcb, 0, &s_op->msgarray_op);
   
    gossip_lsdebug(GOSSIP_MSGPAIR_DEBUG,
                   "AFTER PUSH:smcb->base_frame:%d\tframe_count:%d\n",
                   smcb->base_frame, smcb->frame_count);

    return SM_ACTION_COMPLETE;
} /* end action call_msgpairarray */

static PINT_sm_action cleanup_msgpairarray (struct PINT_smcb *smcb
                                           ,job_status_s *js_p)
{   
   gossip_debug(GOSSIP_SERVER_DEBUG,"Executing pvfs2_pjmp_call_msgpairarray_sm:cleanup_msgpairarray"
                                    "....\n");
   struct PINT_server_op *s_op GCC_UNUSED
                             = PINT_sm_frame(smcb,PINT_FRAME_CURRENT);

   gossip_if (GOSSIP_SERVER_DEBUG)
   {
        gossip_log("\ts_op:%p\n", s_op);

        gossip_log("\tjs_p->error_code:%d\n" ,js_p->error_code);
        gossip_log("\tBEFORE POP:smcb->frame_base:%d\tframe_count:%d\n"
                                        ,smcb->base_frame,smcb->frame_count);

        gossip_log("\ts_op->msgarray_op.msgpair.req.op:%d\n"
                                         ,s_op->msgarray_op.msgpair.req.op );

        gossip_log("\ts_op->resp.status:%d\n" ,s_op->resp.status);
    }
    gossip_end; 
    return SM_ACTION_TERMINATE;
} /* end action cleanup_msgpairarray */

static GCC_UNUSED
PINT_sm_action pjmp_remove_work_release_job(struct PINT_smcb *smcb,
                                                   job_status_s *js_p)
{
   int ret = -1;
   job_id_t tmp_id;
   struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);

   /* save the error-code returned from the previous step */
   s_op->u.remove.saved_error_code = js_p->error_code;

   ret = job_req_sched_release( s_op->scheduled_id
                               ,smcb
                               ,0
                               ,js_p
                               ,&tmp_id
                               ,server_job_context);
 
   return ret;  
} /* end pjmp_remove_work_release_job */

static GCC_UNUSED
PINT_sm_action pjmp_remove_work_execute_terminate(struct PINT_smcb *smcb,
                                                         job_status_s *js_p)
{
   struct PINT_server_op *s_op = PINT_sm_frame(smcb, PINT_FRAME_CURRENT);

   js_p->error_code = s_op->u.remove.saved_error_code;

   return SM_ACTION_TERMINATE;
} /* end pjmp_remove_execute_terminate */


